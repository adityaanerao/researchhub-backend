# Server Configuration
PORT=8080
APP_ENV=development
APP_NAME=ResearchHub
APP_URL=http://localhost:4200
API_URL=http://localhost:8080/api/v1

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=researchhub_db
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=change_this_to_a_secure_random_64_char_secret_in_production
JWT_EXPIRY_HOURS=24
RESET_TOKEN_EXPIRY_MINUTES=60

# File Storage Configuration (local or s3)
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_MB=25

# AWS S3 Compatible Object Storage (Production)
S3_REGION=ap-southeast-2
S3_BUCKET=researchimage
S3_ENDPOINT=https://s3.ap-southeast-2.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SMTP Email Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@researchhub.org
SMTP_FROM_NAME=ResearchHub Editorial Office

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Seed Development Data (true only in development)
SEED_DEV_DATA=true
